resource app_signature "application/x-vnd.Kunanyi-Summit";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
    major = 0,
    middle = 1,
    minor = 0,
    variety = B_APPV_DEVELOPMENT,
    internal = 1,
    short_info = "Summit for KunanyiOS",
    long_info = "A native WebKit browser for KunanyiOS and Haiku."
};
resource file_types message {
    "types" = "text/html",
    "types" = "application/x-vnd.Be.URL.http",
    "types" = "application/x-vnd.Be.URL.https"
};
resource(101, "BEOS:ICON") #'VICN' import "Summit.hvif";
resource(201, "toolbar-0") #'VICN' import "toolbar/back.hvif";
resource(202, "toolbar-1") #'VICN' import "toolbar/forward.hvif";
resource(203, "toolbar-2") #'VICN' import "toolbar/reload.hvif";
resource(204, "toolbar-3") #'VICN' import "toolbar/stop.hvif";
resource(205, "toolbar-4") #'VICN' import "toolbar/plus.hvif";
resource(206, "toolbar-5") #'VICN' import "toolbar/bookmark.hvif";
resource(207, "toolbar-6") #'VICN' import "toolbar/bookmark-filled.hvif";
resource(208, "toolbar-7") #'VICN' import "toolbar/downloads.hvif";
resource(209, "toolbar-8") #'VICN' import "toolbar/home.hvif";
resource(210, "toolbar-9") #'VICN' import "toolbar/more.hvif";
resource(211, "toolbar-10") #'VICN' import "toolbar/forward.hvif";

