--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -155,3 +155,11 @@
 install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libjxr.pc
   DESTINATION ${JXRLIB_INSTALL_LIB_DIR}/pkgconfig COMPONENT Header
 )
+
+# Haiku's loader needs full PIC when a PIE executable refers to an exported
+# data table in a shared library. This must follow CMake's automatic -fPIE.
+if(CMAKE_SYSTEM_NAME STREQUAL "Haiku")
+  target_compile_options(JxrEncApp PRIVATE -fPIC)
+  target_compile_options(JxrDecApp PRIVATE -fPIC)
+endif()
+
