+void EditorClientHaiku::redo()
+{
+    if (canRedo()) {
+        RefPtr<WebCore::UndoStep> step(m_redoStack.takeLast());
+
+        ASSERT(!m_isInRedo);
+        m_isInRedo = true;
+        // reapply will call us back to push this step onto the undo stack.
+        step->reapply();
+        m_isInRedo = false;
+    }
