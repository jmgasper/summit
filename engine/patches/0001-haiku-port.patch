+void BWebView::Pulse()
+{
+	if (!fAutoHidePointer || !IsFocus() || !Window()->IsActive())
+		return;
+
+	if (Bounds().Contains(fLastMousePos)
+		&& system_time() - fLastMouseMovedTime > 800000) {
+		be_app->ObscureCursor();
+	}
+}
