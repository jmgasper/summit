+bool WebExtensionContext::hasActiveUserGesture(WebExtensionTab& tab) const
+{
+    ASSERT(isLoaded());
+    if (!isLoaded())
+        return false;
+
+#if PLATFORM(HAIKU)
+    if (tab.extensionContext() != this || !tab.isOpen() || !tab.extensionHasAccess())
+        return false;
+#endif
+    return tab.hasActiveUserGesture();
