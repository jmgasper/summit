+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "ImageBufferHaikuSurfaceBackend.h"
+
+#include "BitmapImage.h"
+#include "ColorUtilities.h"
+#include "GraphicsContextHaiku.h"
+#include "ImageData.h"
