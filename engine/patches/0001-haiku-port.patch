+        m_isScheduled = false;
+        timer = std::exchange(m_timer, nullptr);
+    }
+    if (timer)
+        timer->stop();
+}
+
+bool RunLoopObserver::isScheduled() const
+{
+    Locker locker { m_timerLock };
