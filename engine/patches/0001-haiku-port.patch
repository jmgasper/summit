+    WebExtensionTemporaryDirectoryHaiku& operator=(const WebExtensionTemporaryDirectoryHaiku&) = delete;
+    ~WebExtensionTemporaryDirectoryHaiku();
+
+    const String& path() const { return m_path; }
+    String release();
+
+private:
+    String m_path;
+};
