+}
+
+ResourceError invalidPageRangeToPrint(const URL& failingURL)
+{
+    return ResourceError(String::fromUTF8(errorDomainPrint), PrintErrorInvalidPageRange, failingURL, ASCIILiteral::fromLiteralUnsafe("Invalid page range"));
+}
