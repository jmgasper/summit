+void FullscreenVideoController::setVideoElement(HTMLVideoElement* videoElement)
+{
+    if (videoElement == m_videoElement)
+        return;
+
+    m_videoElement = videoElement;
+    if (!m_videoElement) {
+        // Can't do full-screen, just get out
+        exitFullscreen();
+    }
+}
