+void WebCore::Pasteboard::writeMarkup(WTF::String const& text)
+{
+    AutoClipboardLocker locker(be_clipboard);
+    if (!locker.isLocked())
+        return;
+
+    be_clipboard->Clear();
+    BMessage* data = be_clipboard->Data();
+    if (!data)
+        return;
+
+    BString string(text);
+    data->AddData("text/html", B_MIME_TYPE, string.String(), string.Length());
+    be_clipboard->Commit();
+}
