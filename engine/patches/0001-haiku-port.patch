+void MediaPlayerPrivate::load(const String& url)
+{
+    cancelLoad();
+
+    m_mediaLock.Lock();
+    m_abort = false;
+    m_url = url;
+
+    m_loadingThread = spawn_thread(loadingThread, "media loader", B_NORMAL_PRIORITY, this);
+    if (m_loadingThread >= 0)
+        resume_thread(m_loadingThread);
+
+    m_mediaLock.Unlock();
+}
+
+
+void MediaPlayerPrivate::cancelLoad()
+{
+    static const bool logCancelTiming = [] {
+        const char* value = std::getenv("SUMMIT_MEDIA_CANCEL_TIMING");
+        return value && value[0] == '1' && !value[1];
+    }();
+    bigtime_t began = logCancelTiming ? system_time() : 0;
+    bool hadLoader = m_loadingThread >= 0;
+    bool hadVideo = m_videoThread >= 0;
+    m_abort = true;
+
+    // Neither the decoder thread nor the sound callback can finish while the
+    // caller holds m_mediaLock. Join and stop them before taking it.
+    if (m_loadingThread >= 0) {
+        status_t status;
+        wait_for_thread(m_loadingThread, &status);
+        m_loadingThread = -1;
+    }
+    bigtime_t loaderDone = logCancelTiming ? system_time() : 0;
+
+    if (m_videoThread >= 0) {
+        status_t status;
+        wait_for_thread(m_videoThread, &status);
+        m_videoThread = -1;
+    }
+    bigtime_t videoDone = logCancelTiming ? system_time() : 0;
+
+    if (m_soundPlayer)
+        m_soundPlayer->Stop();
+    bigtime_t soundDone = logCancelTiming ? system_time() : 0;
+
+    m_mediaLock.Lock();
+    delete m_soundPlayer;
+    m_soundPlayer = nullptr;
+
+    delete m_mediaFile;
+    m_mediaFile = nullptr;
+    delete m_downloadFile;
+    m_downloadFile = nullptr;
+    m_audioTrack = nullptr;
+    m_videoTrack = nullptr;
+    m_hasVideo = false;
+    delete m_frameBuffer;
+    m_frameBuffer = nullptr;
+    m_currentTime = 0;
+    m_duration = 0;
+    m_ended = false;
+    if (!m_downloadPath.isEmpty()) {
+        unlink(m_downloadPath.utf8().legacyCStringPointer());
+        m_downloadPath = { };
+    }
+    m_mediaLock.Unlock();
+    if (logCancelTiming) {
+        bigtime_t ended = system_time();
+        if (ended - began > 33000)
+            fprintf(stderr, "Summit media cancel: loader=%d video=%d waitLoader=%.1fms waitVideo=%.1fms stopSound=%.1fms cleanup=%.1fms total=%.1fms\n",
+                hadLoader, hadVideo, (loaderDone - began) / 1000.0, (videoDone - loaderDone) / 1000.0,
+                (soundDone - videoDone) / 1000.0, (ended - soundDone) / 1000.0, (ended - began) / 1000.0);
+    }
+}
