new file mode 100644
index 0000000000000000000000000000000000000000..d28a6cad6339adf79b155cf974e85bfd0780c24c
--- /dev/null
+++ b/Source/WebKit/UIProcess/API/haiku/WebKitVersion.h.in
@@ -0,0 +1,63 @@
+/*
