+void CurlRequest::setRequestPaused(bool paused)
+{
+    {
+        Locker locker { m_pauseStateMutex };
+
+        auto savedState = shouldBePaused();
+        m_isPausedOfRequest = paused;
+        if (shouldBePaused() == savedState)
+            return;
+    }
