+Ref<MediaTimePromise> MediaPlayerPrivate::seekToTarget(const SeekTarget& time)
+{
+    if (!m_mediaLock.Lock())
+        return MediaTimePromise::createAndReject(PlatformMediaError::InvalidState);
+    if (!m_videoTrack && !m_audioTrack) {
+        m_mediaLock.Unlock();
+        return MediaTimePromise::createAndReject(PlatformMediaError::NotReady);
+    }
+    bigtime_t newTime = (bigtime_t)(time.time.toDouble() * 1000000);
+    status_t status = B_OK;
+    if (m_videoTrack)
+        status = m_videoTrack->SeekToTime(&newTime);
+    if (m_audioTrack && status == B_OK)
+        status = m_audioTrack->SeekToTime(&newTime);
+    if (status != B_OK) {
+        m_mediaLock.Unlock();
+        return MediaTimePromise::createAndReject(PlatformMediaError::NotSupportedError);
+    }
+
+    m_currentTime = newTime / 1000000.f;
+    m_ended = false;
+
+    if (m_paused && m_videoTrack && m_frameBuffer) {
+        int64 count = 1;
+        if (m_videoTrack->ReadFrames(m_frameBuffer->Bits(), &count) == B_OK) {
+            callOnMainThread([p = WeakPtr(this)] {
+                if (p)
+                    p->m_player.repaint();
+            });
+        }
+    }
+    auto position = currentTime();
+    m_mediaLock.Unlock();
+    m_player.timeChanged();
+    return MediaTimePromise::createAndResolve(position);
+}
