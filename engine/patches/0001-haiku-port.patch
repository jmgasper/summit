+++ b/Source/WebKit/UIProcess/haiku/JavaScriptDialogHaiku.h
@@ -0,0 +1,279 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include "JavaScriptDialogRequestsHaiku.h"
+#include <Button.h>
+#include <GroupView.h>
+#include <LayoutBuilder.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <ScrollView.h>
+#include <StringView.h>
+#include <TextView.h>
+#include <Window.h>
+#include <atomic>
+#include <deque>
+#include <memory>
+
+namespace WebKit {
+
+enum class JavaScriptDialogKindHaiku : int32 { Alert, Confirm, Prompt, BeforeUnload };
+enum : uint32 {
+    javaScriptDialogShowHaiku = 'jssh', javaScriptDialogClosedHaiku = 'jscl',
+    javaScriptDialogDismissHaiku = 'jsdi', javaScriptDialogsCancelHaiku = 'jsca',
+    javaScriptDialogAcceptHaiku = 'jsok', javaScriptDialogCancelHaiku = 'jsno'
+};
+
+// BTextControl's internal text view passes inserted text through BString,
+// which cannot preserve embedded NULs. Use the native BTextView byte buffer
+// directly, with the same single-line editing behavior.
+class JavaScriptPromptInputHaiku final : public BTextView {
+public:
+    JavaScriptPromptInputHaiku() : BTextView("dialog-input")
+    {
+        SetWordWrap(false);
+        SetDoesUndo(true);
+        SetExplicitMinSize(BSize(490, 26));
+        SetExplicitMaxSize(BSize(B_SIZE_UNLIMITED, 26));
+    }
+
+    void KeyDown(const char* bytes, int32 length) override
+    {
+        if (length == 1 && bytes[0] == B_ENTER && Window()) {
+            Window()->PostMessage(javaScriptDialogAcceptHaiku);
+            return;
+        }
+        BTextView::KeyDown(bytes, length);
+    }
+
+protected:
+    void InsertText(const char* text, int32 length, int32 offset, const text_run_array* runs) override
+    {
+        if (length <= 0)
+            return;
+        std::string filtered(text, static_cast<size_t>(length));
+        for (auto& byte : filtered) {
+            if (byte == '\n' || byte == '\r')
+                byte = ' ';
+        }
+        BTextView::InsertText(filtered.data(), length, offset, runs);
+    }
+};
+
+class JavaScriptDialogActivityHaiku {
+public:
+    static uint32_t activeCount() { return s_active.load(); }
+protected:
+    JavaScriptDialogActivityHaiku() { ++s_active; }
+    ~JavaScriptDialogActivityHaiku() { --s_active; }
+private:
+    static inline std::atomic<uint32_t> s_active { 0 };
+};
+
+// This base order keeps activity nonzero through the BWindow/BLooper
+// destructors, which still use the native application and app_server.
+class JavaScriptDialogHaiku final : private JavaScriptDialogActivityHaiku, public BWindow {
+public:
+    static uint32_t activeCount() { return JavaScriptDialogActivityHaiku::activeCount(); }
+    JavaScriptDialogHaiku(uint64_t identifier, JavaScriptDialogKindHaiku kind,
+        const std::string& origin, const std::string& topOrigin, const std::string& message, const std::string& defaultValue,
+        std::shared_ptr<JavaScriptDialogRequestsHaiku> requests, BMessenger target)
+        : BWindow(BRect(0, 0, 559, 359), "Web page dialog", B_TITLED_WINDOW_LOOK, B_MODAL_SUBSET_WINDOW_FEEL,
+            B_ASYNCHRONOUS_CONTROLS | B_NOT_RESIZABLE | B_NOT_ZOOMABLE | B_AUTO_UPDATE_SIZE_LIMITS | B_CLOSE_ON_ESCAPE)
+        , m_identifier(identifier), m_requests(std::move(requests)), m_target(target)
+    {
+        auto* originView = textView("dialog-origin", origin, 76);
+        auto* body = textView("dialog-message", kind == JavaScriptDialogKindHaiku::BeforeUnload
+            ? "This page may contain unsaved changes. Leave this page?" : message, 140);
+        auto* scroll = new BScrollView("dialog-message-scroll", body, 0, false, true, B_NO_BORDER);
+        BLayoutBuilder::Group<> layout(this, B_VERTICAL, 10);
+        layout.SetInsets(16).Add(new BStringView("dialog-site-label", "Website:"))
+            .Add(originView);
+        if (!topOrigin.empty()) {
+            layout.Add(new BStringView("dialog-top-label", "Embedded in:"))
+                .Add(textView("dialog-top-origin", topOrigin, 76));
+        }
+        layout.Add(scroll);
+        if (kind == JavaScriptDialogKindHaiku::Prompt) {
+            m_input = new JavaScriptPromptInputHaiku();
+            m_input->SetText(defaultValue.data(), static_cast<int32>(defaultValue.size()));
+            layout.Add(new BScrollView("dialog-input-border", m_input, 0, false, false, B_FANCY_BORDER));
+        }
+        auto* buttons = new BGroupView(B_HORIZONTAL, 8);
+        BLayoutBuilder::Group<> buttonLayout(buttons);
+        buttonLayout.AddGlue();
+        BButton* cancel = nullptr;
+        if (kind != JavaScriptDialogKindHaiku::Alert) {
+            cancel = new BButton("dialog-cancel", kind == JavaScriptDialogKindHaiku::BeforeUnload ? "Stay" : "Cancel",
+                new BMessage(javaScriptDialogCancelHaiku));
+            buttonLayout.Add(cancel);
+        }
+        auto* accept = new BButton("dialog-accept", kind == JavaScriptDialogKindHaiku::BeforeUnload ? "Leave" : "OK",
+            new BMessage(javaScriptDialogAcceptHaiku));
+        buttonLayout.Add(accept);
+        layout.Add(buttons);
+        SetDefaultButton(kind == JavaScriptDialogKindHaiku::BeforeUnload ? cancel : accept);
+        ResizeToPreferred();
+        if (m_input) {
+            m_input->MakeFocus();
+            m_input->SelectAll();
+        }
+    }
+
+    ~JavaScriptDialogHaiku() override { finish(false); }
+
+    bool QuitRequested() override
+    {
+        finish(false);
+        return true;
+    }
+
+    void MessageReceived(BMessage* message) override
+    {
+        switch (message->what) {
+        case javaScriptDialogAcceptHaiku:
+            finish(true);
+            PostMessage(B_QUIT_REQUESTED);
+            return;
+        case javaScriptDialogCancelHaiku:
+        case javaScriptDialogDismissHaiku:
+            finish(false);
+            PostMessage(B_QUIT_REQUESTED);
+            return;
+        default:
+            BWindow::MessageReceived(message);
+        }
+    }
+
+private:
+    static BTextView* textView(const char* name, const std::string& text, float height)
+    {
+        auto* view = new BTextView(name);
+        view->SetText(text.data(), static_cast<int32>(text.size()));
+        view->MakeEditable(false);
+        view->MakeSelectable(true);
+        view->SetWordWrap(true);
+        view->SetViewUIColor(B_PANEL_BACKGROUND_COLOR);
+        view->SetExplicitMinSize(BSize(490, height));
+        view->SetExplicitMaxSize(BSize(B_SIZE_UNLIMITED, height));
+        return view;
+    }
+
+    void finish(bool accepted)
+    {
+        if (m_finished)
+            return;
+        m_finished = true;
+        std::string value;
+        if (accepted && m_input)
+            value.assign(m_input->Text(), m_input->TextLength());
+        m_requests->complete(m_identifier, accepted, std::move(value));
+        BMessage closed(javaScriptDialogClosedHaiku);
+        closed.AddUInt64("identifier", m_identifier);
+        m_target.SendMessage(&closed, static_cast<BHandler*>(nullptr), 0);
+    }
+
+    const uint64_t m_identifier;
+    const std::shared_ptr<JavaScriptDialogRequestsHaiku> m_requests;
+    const BMessenger m_target;
+    JavaScriptPromptInputHaiku* m_input { nullptr };
+    bool m_finished { false };
+};
+
+// Owned and called only by the native BWebKitView's window looper. Dialogs have
+// their own native loopers; this queue keeps one sheet visible per web view.
+class JavaScriptDialogHostHaiku {
+public:
+    explicit JavaScriptDialogHostHaiku(std::shared_ptr<JavaScriptDialogRequestsHaiku> requests)
+        : m_requests(std::move(requests)) { }
+    ~JavaScriptDialogHostHaiku() { cancelAll(); }
+
+    void show(BMessage message, BWindow* parent, BMessenger target, bool visible)
+    {
+        uint64 identifier;
+        if (message.FindUInt64("identifier", &identifier) != B_OK || !m_requests->contains(identifier))
+            return;
+        m_pending.push_back(std::move(message));
+        pump(parent, target, visible);
+    }
+
+    void pump(BWindow* parent, BMessenger target, bool visible)
+    {
+        if (!parent || !visible || m_active.IsValid())
+            return;
+        while (!m_pending.empty()) {
+            BMessage message = std::move(m_pending.front());
+            m_pending.pop_front();
+            uint64 identifier;
+            int32 kind;
+            if (message.FindUInt64("identifier", &identifier) != B_OK || !m_requests->contains(identifier))
+                continue;
+            if (message.FindInt32("kind", &kind) != B_OK || kind < 0
+                || kind > static_cast<int32>(JavaScriptDialogKindHaiku::BeforeUnload)) {
+                m_requests->complete(identifier, false);
+                continue;
+            }
+            auto origin = text(message, "origin");
+            if (origin.empty()) {
+                m_requests->complete(identifier, false);
+                continue;
+            }
+            auto* dialog = new JavaScriptDialogHaiku(identifier, static_cast<JavaScriptDialogKindHaiku>(kind),
+                origin, text(message, "topOrigin"), text(message, "message"),
+                text(message, "defaultValue"), m_requests, target);
+            if (dialog->AddToSubset(parent) != B_OK) {
+                dialog->Quit();
+                continue;
+            }
+            dialog->CenterIn(parent->Frame());
+            m_identifier = identifier;
+            m_active = BMessenger(dialog);
+            dialog->Show();
+            return;
+        }
+    }
+
+    void didClose(uint64 identifier, BWindow* parent, BMessenger target, bool visible)
+    {
+        if (identifier != m_identifier)
+            return;
+        m_active = BMessenger();
+        m_identifier = 0;
+        pump(parent, target, visible);
+    }
+
+    void cancelAll()
+    {
+        for (const auto& message : m_pending) {
+            uint64 identifier;
+            if (message.FindUInt64("identifier", &identifier) == B_OK)
+                m_requests->complete(identifier, false);
+        }
+        m_pending.clear();
+        m_requests->complete(m_identifier, false);
+        BMessage dismiss(javaScriptDialogDismissHaiku);
+        m_active.SendMessage(&dismiss, static_cast<BHandler*>(nullptr), 0);
+        m_active = BMessenger();
+        m_identifier = 0;
+    }
+
+private:
+    static std::string text(const BMessage& message, const char* name)
+    {
+        const void* bytes;
+        ssize_t length;
+        if (message.FindData(name, B_RAW_TYPE, &bytes, &length) == B_OK && length > 0
+            && !static_cast<const char*>(bytes)[length - 1])
+            return { static_cast<const char*>(bytes), static_cast<size_t>(length - 1) };
+        const char* value = message.FindString(name);
+        return value ? value : "";
+    }
+
+    const std::shared_ptr<JavaScriptDialogRequestsHaiku> m_requests;
+    std::deque<BMessage> m_pending;
+    BMessenger m_active;
+    uint64_t m_identifier { 0 };
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/JavaScriptDialogRequestsHaiku.h b/Source/WebKit/UIProcess/haiku/JavaScriptDialogRequestsHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..57f5eeb4902e21afc628362e9090894effbbdf13
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/JavaScriptDialogRequestsHaiku.h
@@ -0,0 +1,77 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace WebKit {
+
+// Native window threads may finish a request while the WebKit thread closes
+// the page. Remove callbacks under the lock, then invoke them outside it. The
+// bridge supplies callbacks that dispatch their WebKit completion onto main.
+class JavaScriptDialogRequestsHaiku {
+public:
+    using Completion = std::function<void(bool, std::string)>;
+
+    ~JavaScriptDialogRequestsHaiku() { cancelAll(true); }
+
+    uint64_t add(Completion completion)
+    {
+        {
+            std::lock_guard guard(m_mutex);
+            if (!m_closed) {
+                do { ++m_nextIdentifier; } while (!m_nextIdentifier || m_requests.contains(m_nextIdentifier));
+                m_requests.emplace(m_nextIdentifier, std::move(completion));
+                return m_nextIdentifier;
+            }
+        }
+        completion(false, { });
+        return 0;
+    }
+
+    bool contains(uint64_t identifier) const
+    {
+        std::lock_guard guard(m_mutex);
+        return m_requests.contains(identifier);
+    }
+
+    bool complete(uint64_t identifier, bool accepted, std::string value = { })
+    {
+        Completion completion;
+        {
+            std::lock_guard guard(m_mutex);
+            auto found = m_requests.find(identifier);
+            if (found == m_requests.end())
+                return false;
+            completion = std::move(found->second);
+            m_requests.erase(found);
+        }
+        completion(accepted, std::move(value));
+        return true;
+    }
+
+    void cancelAll(bool close = false)
+    {
+        std::map<uint64_t, Completion> requests;
+        {
+            std::lock_guard guard(m_mutex);
+            m_closed |= close;
+            requests.swap(m_requests);
+        }
+        for (auto& [identifier, completion] : requests)
+            completion(false, { });
+    }
+
+private:
+    mutable std::mutex m_mutex;
+    uint64_t m_nextIdentifier { 0 };
+    bool m_closed { false };
+    std::map<uint64_t, Completion> m_requests;
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/NativeSelectPopupHaiku.h b/Source/WebKit/UIProcess/haiku/NativeSelectPopupHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..3b6bd0d9d011c797c2a2e6deb3e2bbbd4eec80ce
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/NativeSelectPopupHaiku.h
@@ -0,0 +1,233 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <Application.h>
+#include <MenuItem.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <OS.h>
+#include <PopUpMenu.h>
+#include <Screen.h>
+#include <algorithm>
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace WebKit {
+
+// This class owns only native data. Menu tracking and destruction take place
+// on its worker; cancel never waits for that worker or touches a raw BMenu.
+class NativeSelectPopupHaiku final {
+public:
+    struct Item {
+        std::string label;
+        bool enabled { true };
+        bool groupLabel { false };
+        bool separator { false };
+    };
+
+    NativeSelectPopupHaiku(std::vector<Item>&& items, BRect anchor, bool rightToLeft, int32 selectedIndex, std::function<void(int32)>&& completion)
+        : m_control(std::make_shared<Control>(std::move(items), anchor, rightToLeft, selectedIndex, std::move(completion))) { }
+
+    ~NativeSelectPopupHaiku() { cancel(); }
+
+    static size_t activeCount() { return s_activeCount.load(); }
+
+    status_t start()
+    {
+        if (m_started)
+            return B_NOT_ALLOWED;
+        m_started = true;
+        auto* owner = new std::shared_ptr<Control>(m_control);
+        ++s_activeCount;
+        thread_id thread = spawn_thread([](void* data) -> int32 {
+            std::unique_ptr<std::shared_ptr<Control>> owner(static_cast<std::shared_ptr<Control>*>(data));
+            auto control = *owner;
+            int32 index = -1;
+            if (!control->cancelled && !control->items.empty()) {
+                auto menu = std::make_unique<Menu>(control);
+                if (menu->populate()) {
+                    BPoint location = menu->location();
+                    // BPopUpMenu's async Go has no completion or failure result.
+                    // Its synchronous result is safe here, off the WebKit loop,
+                    // and covers selection, Escape, outside click and failure.
+                    BMenuItem* chosen = menu->Go(location, false, true, control->anchor, false);
+                    if (chosen && !control->cancelled)
+                        index = menu->IndexOf(chosen);
+                }
+                // Go has joined its own tracking thread. Destroy the native
+                // menu before posting the completion to the application.
+                menu.reset();
+            }
+            if (control->cancelled)
+                index = -1;
+            control->completion(index);
+            --s_activeCount;
+            return B_OK;
+        }, "WebKit select popup", B_NORMAL_PRIORITY, owner);
+        if (thread < B_OK) {
+            --s_activeCount;
+            delete owner;
+            return thread;
+        }
+        status_t status = resume_thread(thread);
+        if (status != B_OK) {
+            kill_thread(thread);
+            --s_activeCount;
+            delete owner;
+        }
+        return status;
+    }
+
+    void cancel()
+    {
+        m_control->cancelled = true;
+        sendEscape(target());
+    }
+
+    BMessenger target() const
+    {
+        std::lock_guard lock(m_control->mutex);
+        return m_control->target;
+    }
+
+private:
+    struct Control {
+        Control(std::vector<Item>&& items, BRect anchor, bool rightToLeft, int32 selectedIndex, std::function<void(int32)>&& completion)
+            : items(std::move(items)), anchor(anchor), rightToLeft(rightToLeft), selectedIndex(selectedIndex), completion(std::move(completion)) { }
+        const std::vector<Item> items;
+        const BRect anchor;
+        const bool rightToLeft;
+        const int32 selectedIndex;
+        const std::function<void(int32)> completion;
+        std::atomic<bool> cancelled { false };
+        std::mutex mutex;
+        BMessenger target;
+    };
+
+    static void sendEscape(BMessenger target)
+    {
+        if (!target.IsValid())
+            return;
+        BMessage message(B_KEY_DOWN);
+        const char escape[] = { B_ESCAPE, 0 };
+        message.AddString("bytes", escape);
+        target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+
+    class Menu final : public BPopUpMenu {
+        class Option final : public BMenuItem {
+        public:
+            explicit Option(const char* label) : BMenuItem(label, nullptr) { }
+            bool isHighlighted() const { return IsSelected(); }
+        };
+
+    public:
+        explicit Menu(std::shared_ptr<Control> control)
+            : BPopUpMenu("WebKit select", true, false), m_control(std::move(control))
+        {
+            SetTriggersEnabled(false);
+            SetTrackingHook([](BMenu*, void* state) {
+                return static_cast<Control*>(state)->cancelled.load();
+            }, m_control.get());
+        }
+
+        bool populate()
+        {
+            for (size_t i = 0; i < m_control->items.size(); ++i) {
+                const auto& source = m_control->items[i];
+                if (source.separator) {
+                    if (!AddSeparatorItem())
+                        return false;
+                    continue;
+                }
+                auto item = std::make_unique<Option>(source.label.c_str());
+                item->SetEnabled(source.enabled && !source.groupLabel);
+                item->SetMarked(static_cast<int32>(i) == m_control->selectedIndex);
+                if (!AddItem(item.get()))
+                    return false;
+                item.release();
+            }
+            return true;
+        }
+
+        BPoint location()
+        {
+            BRect screen = BScreen().Frame();
+            SetMaxContentWidth(std::max(1.0f, screen.Width() - 40));
+            SetExplicitMinSize(BSize(std::clamp(m_control->anchor.Width(), 1.0f, std::max(1.0f, screen.Width() - 2)), B_SIZE_UNSET));
+            DoLayout();
+            BPoint point = m_control->anchor.LeftTop();
+            if (m_control->rightToLeft)
+                point.x = m_control->anchor.right - Bounds().Width();
+            if (auto* marked = ItemAt(m_control->selectedIndex))
+                point.y -= marked->Frame().top;
+            point.x = std::clamp(point.x, screen.left, std::max(screen.left, screen.right - Bounds().Width()));
+            // Oversized menus keep their full content height. BMenu provides
+            // native screen clipping, scroll arrows and marked-item scrolling.
+            point.y = std::clamp(point.y, screen.top, std::max(screen.top, screen.bottom - Bounds().Height()));
+            return point;
+        }
+
+        void AttachedToWindow() override
+        {
+            BPopUpMenu::AttachedToWindow();
+            BMessenger messenger(this);
+            {
+                std::lock_guard lock(m_control->mutex);
+                m_control->target = messenger;
+            }
+            if (m_control->cancelled)
+                sendEscape(messenger);
+        }
+
+        void KeyDown(const char* bytes, int32 count) override
+        {
+            if (count <= 0)
+                return;
+            bool highlighted = false;
+            for (int32 i = 0; i < CountItems(); ++i) {
+                if (auto* option = dynamic_cast<Option*>(ItemAt(i)); option && option->isHighlighted()) {
+                    highlighted = true;
+                    break;
+                }
+            }
+            // BMenu deselects highlighted items when the pointer is outside
+            // the menu. Begin keyboard navigation from the current value,
+            // using native navigation to skip groups, disabled rows and rules.
+            auto* selected = ItemAt(m_control->selectedIndex);
+            if (!highlighted && selected && selected->IsEnabled()
+                && (bytes[0] == B_UP_ARROW || bytes[0] == B_DOWN_ARROW || bytes[0] == B_ENTER || bytes[0] == B_SPACE)) {
+                const char down = B_DOWN_ARROW;
+                for (int32 i = 0; i <= m_control->selectedIndex; ++i) {
+                    if (ItemAt(i)->IsEnabled())
+                        BPopUpMenu::KeyDown(&down, 1);
+                }
+            }
+            BPopUpMenu::KeyDown(bytes, count);
+        }
+
+        void DetachedFromWindow() override
+        {
+            {
+                std::lock_guard lock(m_control->mutex);
+                m_control->target = { };
+            }
+            BPopUpMenu::DetachedFromWindow();
+        }
+
+    private:
+        const std::shared_ptr<Control> m_control;
+    };
+
+    const std::shared_ptr<Control> m_control;
+    bool m_started { false };
+    inline static std::atomic<size_t> s_activeCount { 0 };
+};
+
+} // namespace WebKit
