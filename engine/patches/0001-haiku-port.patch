+    m_platformPath.LineTo(BPoint(r.rect.maxX(), r.rect.y()));
+    m_platformPath.LineTo(BPoint(r.rect.maxX(), r.rect.maxY()));
+    m_platformPath.LineTo(BPoint(r.rect.x(), r.rect.maxY()));
