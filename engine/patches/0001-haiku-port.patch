+#if ENABLE(NAVIGATOR_CONTENT_UTILS)
+    WebCore::provideNavigatorContentUtilsTo(*page(),
+        std::make_unique<WebKit::WebNavigatorContentUtilsClient>());
+#endif
+
+    fSettings = new BWebSettings(&page()->settings());
+}
