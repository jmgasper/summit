diff --git a/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionTabCommandsHaiku.cpp b/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionTabCommandsHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..08f99d8fd6fbb9916f68c0a8e700ba8ce6850773
--- /dev/null
+++ b/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionTabCommandsHaiku.cpp
@@ -0,0 +1,252 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "WebExtensionTab.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "WebExtensionContext.h"
+#include "WebExtensionUtilities.h"
+#include "WebExtensionWindow.h"
+#include "WebKitContext.h"
+#include "WebPageProxy.h"
+#include <Message.h>
+#include <WebCore/MediaProducer.h>
+
+// The native browser owns its tabs and windows. Every change below is a request
+// to that host through the context's browser-command bridge; the read-only
+// state in WebExtensionTabHaiku.cpp and WebExtensionWindowHaiku.cpp follows
+// once the host resubmits its window through BWebKitContext::SetBrowserWindowTabs.
+
+namespace WebKit {
+
+using VoidCompletion = CompletionHandler<void(std::expected<void, WebExtensionError>&&)>;
+
+static void failAsynchronously(VoidCompletion&& completion, const String& apiName, ASCIILiteral reason)
+{
+    RunLoop::mainSingleton().dispatch([completion = WTF::move(completion), error = toErrorString(apiName, nullString(), reason).isolatedCopy()]() mutable {
+        completion(makeUnexpected(WTF::move(error)));
+    });
+}
+
+static void sendTabCommand(const WebExtensionTab& tab, uint32_t command, const String& apiName, Function<bool(BMessage&)>&& addFields, VoidCompletion&& completion)
+{
+    RefPtr context = tab.extensionContext();
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    if (!context || !tab.isOpen() || !tab.extensionHasAccess()) {
+        failAsynchronously(WTF::move(completion), apiName, "tab not found"_s);
+        return;
+    }
+    bool complete = message.AddUInt32("command", command) == B_OK && context->addNativeBrowserCommandTab(message, tab);
+    if (RefPtr window = complete ? tab.window() : nullptr)
+        complete = context->addNativeBrowserCommandWindow(message, *window);
+    if (complete && addFields)
+        complete = addFields(message);
+    if (!complete) {
+        failAsynchronously(WTF::move(completion), apiName, "the tab is not available in the browser"_s);
+        return;
+    }
+    context->sendNativeBrowserCommand(WTF::move(message), apiName, [completion = WTF::move(completion)](WebExtensionContext::NativeBrowserCommandResult&& result) mutable {
+        if (!result) {
+            completion(makeUnexpected(result.error()));
+            return;
+        }
+        completion({ });
+    });
+}
+
+RefPtr<WebExtensionTab> WebExtensionTab::parentTab() const
+{
+    // The native browser does not record an opener relationship yet.
+    return nullptr;
+}
+
+void WebExtensionTab::setParentTab(RefPtr<WebExtensionTab>, VoidCompletion&& completion)
+{
+    failAsynchronously(WTF::move(completion), "tabs.update()"_s, "it is not implemented for 'openerTabId'"_s);
+}
+
+bool WebExtensionTab::isPinned() const
+{
+    return false;
+}
+
+void WebExtensionTab::setPinned(bool pinned, VoidCompletion&& completion)
+{
+    if (pinned) {
+        failAsynchronously(WTF::move(completion), "tabs.update()"_s, "it is not implemented for 'pinned' set to `true`"_s);
+        return;
+    }
+    completion({ });
+}
+
+bool WebExtensionTab::isPlayingAudio() const
+{
+    RefPtr page = nativePage();
+    return page && isValid() && page->isPlayingAudio();
+}
+
+bool WebExtensionTab::isMuted() const
+{
+    RefPtr page = nativePage();
+    return page && isValid() && page->isAudioMuted();
+}
+
+void WebExtensionTab::setMuted(bool muted, VoidCompletion&& completion)
+{
+    RefPtr page = nativePage();
+    if (!page || !isOpen() || !extensionHasAccess()) {
+        failAsynchronously(WTF::move(completion), "tabs.update()"_s, "tab not found"_s);
+        return;
+    }
+    // Audio muting is page state without a native browser control, so the
+    // engine applies it directly. Capture devices keep their current state.
+    auto state = page->mutedStateFlags();
+    if (muted)
+        state.add(WebCore::MediaProducerMutedState::AudioIsMuted);
+    else
+        state.remove(WebCore::MediaProducerMutedState::AudioIsMuted);
+    page->setMuted(state);
+    if (RefPtr context = m_extensionContext.get())
+        context->didChangeTabProperties(*this, { ChangedProperties::Muted });
+    completion({ });
+}
+
+void WebExtensionTab::activate(VoidCompletion&& completion)
+{
+    sendTabCommand(*this, B_WEBKIT_BROWSER_ACTIVATE_TAB, "tabs.update()"_s, nullptr, WTF::move(completion));
+}
+
+void WebExtensionTab::setSelected(bool selected, VoidCompletion&& completion)
+{
+    // The native tab strip has a single selection, which is its active tab.
+    if (selected == isSelected()) {
+        completion({ });
+        return;
+    }
+    if (!selected) {
+        failAsynchronously(WTF::move(completion), "tabs.update()"_s, "it is not implemented for 'highlighted' or 'selected' set to `false`"_s);
+        return;
+    }
+    activate(WTF::move(completion));
+}
+
+void WebExtensionTab::loadURL(URL url, VoidCompletion&& completion)
+{
+    sendTabCommand(*this, B_WEBKIT_BROWSER_NAVIGATE_TAB, "tabs.update()"_s, [url = WTF::move(url)](BMessage& message) {
+        return message.AddString("url", url.string().utf8().legacyCStringPointer()) == B_OK;
+    }, WTF::move(completion));
+}
+
+void WebExtensionTab::reload(ReloadFromOrigin fromOrigin, VoidCompletion&& completion)
+{
+    sendTabCommand(*this, B_WEBKIT_BROWSER_RELOAD_TAB, "tabs.reload()"_s, [fromOrigin](BMessage& message) {
+        return message.AddBool("bypass_cache", fromOrigin == ReloadFromOrigin::Yes) == B_OK;
+    }, WTF::move(completion));
+}
+
+void WebExtensionTab::goBack(VoidCompletion&& completion)
+{
+    sendTabCommand(*this, B_WEBKIT_BROWSER_GO_BACK, "tabs.goBack()"_s, nullptr, WTF::move(completion));
+}
+
+void WebExtensionTab::goForward(VoidCompletion&& completion)
+{
+    sendTabCommand(*this, B_WEBKIT_BROWSER_GO_FORWARD, "tabs.goForward()"_s, nullptr, WTF::move(completion));
+}
+
+void WebExtensionTab::close(VoidCompletion&& completion)
+{
+    // The command names one tab here; tabs.remove() batches its own request.
+    RefPtr context = extensionContext();
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    static constexpr auto apiName = "tabs.remove()"_s;
+    if (!context || !isOpen() || !extensionHasAccess()) {
+        failAsynchronously(WTF::move(completion), apiName, "tab not found"_s);
+        return;
+    }
+    RefPtr window = this->window();
+    if (message.AddUInt32("command", B_WEBKIT_BROWSER_CLOSE_TABS) != B_OK || !context->addNativeBrowserCommandTab(message, *this)
+        || !window || !context->addNativeBrowserCommandWindow(message, *window)) {
+        failAsynchronously(WTF::move(completion), apiName, "the tab is not available in the browser"_s);
+        return;
+    }
+    context->sendNativeBrowserCommand(WTF::move(message), apiName, [completion = WTF::move(completion)](WebExtensionContext::NativeBrowserCommandResult&& result) mutable {
+        if (!result) {
+            completion(makeUnexpected(result.error()));
+            return;
+        }
+        completion({ });
+    });
+}
+
+static void sendWindowCommand(const WebExtensionWindow& window, uint32_t command, const String& apiName, Function<bool(BMessage&)>&& addFields, VoidCompletion&& completion)
+{
+    RefPtr context = window.extensionContext();
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    if (!context || !window.isOpen() || !window.extensionHasAccess()) {
+        failAsynchronously(WTF::move(completion), apiName, "window not found"_s);
+        return;
+    }
+    bool complete = message.AddUInt32("command", command) == B_OK && context->addNativeBrowserCommandWindow(message, window);
+    if (complete && addFields)
+        complete = addFields(message);
+    if (!complete) {
+        failAsynchronously(WTF::move(completion), apiName, "the window is not available in the browser"_s);
+        return;
+    }
+    context->sendNativeBrowserCommand(WTF::move(message), apiName, [completion = WTF::move(completion)](WebExtensionContext::NativeBrowserCommandResult&& result) mutable {
+        if (!result) {
+            completion(makeUnexpected(result.error()));
+            return;
+        }
+        completion({ });
+    });
+}
+
+WebExtensionWindow::Type WebExtensionWindow::type() const
+{
+    // The registered native browser currently creates normal windows.
+    return Type::Normal;
+}
+
+WebExtensionWindow::State WebExtensionWindow::state() const
+{
+    // The registry does not track minimized, zoomed or fullscreen windows.
+    return State::Normal;
+}
+
+void WebExtensionWindow::setState(State state, VoidCompletion&& completion)
+{
+    sendWindowCommand(*this, B_WEBKIT_BROWSER_SET_WINDOW_STATE, "windows.update()"_s, [state](BMessage& message) {
+        const char* name = "normal";
+        switch (state) {
+        case State::Normal:
+            break;
+        case State::Minimized:
+            name = "minimized";
+            break;
+        case State::Maximized:
+            name = "maximized";
+            break;
+        case State::Fullscreen:
+            name = "fullscreen";
+            break;
+        }
+        return message.AddString("state", name) == B_OK;
+    }, WTF::move(completion));
+}
+
+void WebExtensionWindow::focus(VoidCompletion&& completion)
+{
+    sendWindowCommand(*this, B_WEBKIT_BROWSER_FOCUS_WINDOW, "windows.update()"_s, nullptr, WTF::move(completion));
+}
+
+void WebExtensionWindow::close(VoidCompletion&& completion)
+{
+    sendWindowCommand(*this, B_WEBKIT_BROWSER_CLOSE_WINDOW, "windows.remove()"_s, nullptr, WTF::move(completion));
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
diff --git a/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionTabHaiku.cpp b/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionTabHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fa88a30e102a8178c4b35756e8f1a1f007e93a1b
--- /dev/null
+++ b/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionTabHaiku.cpp
@@ -0,0 +1,237 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "WebExtensionTab.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "BrowserTabRegistryHaiku.h"
+#include "PageLoadState.h"
+#include "WebExtensionContext.h"
+#include "WebExtensionPermission.h"
+#include "WebExtensionController.h"
+#include "WebExtensionTabParameters.h"
+#include "WebPageProxy.h"
+#include "WebsiteDataStore.h"
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebKit {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(WebExtensionTab);
+
+WebExtensionTab::WebExtensionTab(const WebExtensionContext& context, WebPageProxy& page)
+    : m_extensionContext(context)
+    , m_nativePage(page)
+{
+}
+
+WebExtensionContext* WebExtensionTab::extensionContext() const { return m_extensionContext.get(); }
+
+RefPtr<WebPageProxy> WebExtensionTab::nativePage() const
+{
+    RefPtr page = m_nativePage.get();
+    return page && !page->isClosed() ? page : nullptr;
+}
+
+bool WebExtensionTab::isValid() const
+{
+    RefPtr context = m_extensionContext.get();
+    return context && context->isValidTab(*this);
+}
+
+bool WebExtensionTab::operator==(const WebExtensionTab& other) const { return this == &other; }
+bool WebExtensionTab::isOpen() const { return m_isOpen && isValid(); }
+
+bool WebExtensionTab::extensionHasAccess() const
+{
+    return isValid() && (!isPrivate() || m_extensionContext->hasAccessToPrivateData());
+}
+
+bool WebExtensionTab::extensionHasPermission() const
+{
+    RefPtr context = m_extensionContext.get();
+    return context && extensionHasAccess() && context->hasPermission(url(), const_cast<WebExtensionTab*>(this));
+}
+
+URL WebExtensionTab::nativeCommittedOrigin() const
+{
+    RefPtr page = nativePage();
+    if (!page || !isValid())
+        return { };
+    auto& origin = page->pageLoadState().origin();
+    return origin.isOpaque() ? URL { } : origin.toURL();
+}
+
+bool WebExtensionTab::shouldGrantPermissionsOnUserGesture() const
+{
+    RefPtr context = m_extensionContext.get();
+    if (!context || !isOpen() || !extensionHasAccess())
+        return false;
+    auto origin = nativeCommittedOrigin();
+    return origin.isValid() && (origin.protocolIsInHTTPFamily() || (origin.protocolIsFile() && context->hasAccessToFileURLs()));
+}
+
+bool WebExtensionTab::grantNativeTemporaryPermission()
+{
+    if (!shouldGrantPermissionsOnUserGesture())
+        return false;
+    Ref context = *m_extensionContext;
+    if (!m_nativeActiveTabGrant.grant(nativeCommittedOrigin(), context->hasAccessToFileURLs()))
+        return false;
+    m_temporaryPermissionMatchPattern = m_nativeActiveTabGrant.pattern();
+    return true;
+}
+
+bool WebExtensionTab::hasNativeTemporaryPermission(const URL& requestedURL) const
+{
+    RefPtr context = m_extensionContext.get();
+    if (!context || !isOpen() || !extensionHasAccess() || !context->hasPermission(WebExtensionPermission::activeTab()))
+        return false;
+    if (!m_nativeActiveTabGrant.matchesURL(nativeCommittedOrigin(), requestedURL, context->hasAccessToFileURLs()))
+        return false;
+    // Read only the persistent policy here: passing this tab would recurse.
+    // A current denial always overrides a previous user invocation.
+    auto state = context->permissionState(requestedURL, nullptr, WebExtensionContext::PermissionStateOptions::SkipRequestedPermissions);
+    return state != WebExtensionContext::PermissionState::DeniedExplicitly && state != WebExtensionContext::PermissionState::DeniedImplicitly;
+}
+
+bool WebExtensionTab::extensionHasTemporaryPermission() const
+{
+    return hasNativeTemporaryPermission(nativeCommittedOrigin());
+}
+
+bool WebExtensionTab::clearNativeUserGesture()
+{
+    bool changed = m_activeUserGesture || m_nativeActiveTabGrant.isGranted();
+    m_activeUserGesture = false;
+    m_nativeActiveTabGrant.clear();
+    m_temporaryPermissionMatchPattern = nullptr;
+    return changed;
+}
+
+void WebExtensionTab::nativeDidCommitNavigation()
+{
+    m_activeUserGesture = false;
+    if (m_nativeActiveTabGrant.revokeForNavigation(nativeCommittedOrigin()))
+        m_temporaryPermissionMatchPattern = nullptr;
+}
+
+bool WebExtensionTab::isPrivate() const
+{
+    RefPtr page = nativePage();
+    return page && page->websiteDataStore().sessionID().isEphemeral();
+}
+
+RefPtr<WebExtensionWindow> WebExtensionTab::window() const
+{
+    RefPtr context = m_extensionContext.get();
+    RefPtr page = nativePage();
+    if (!context || !page || !isValid())
+        return nullptr;
+    RefPtr controller = context->extensionController();
+    auto state = controller->nativeBrowserTabs()->tab(page->identifier());
+    return state ? context->getOrCreateNativeWindow(state->windowIdentifier) : nullptr;
+}
+
+size_t WebExtensionTab::index() const
+{
+    RefPtr context = m_extensionContext.get();
+    RefPtr page = nativePage();
+    if (!context || !page || !isValid())
+        return notFound;
+    RefPtr controller = context->extensionController();
+    auto state = controller->nativeBrowserTabs()->tab(page->identifier());
+    return state ? state->index : notFound;
+}
+
+bool WebExtensionTab::isActive() const
+{
+    RefPtr context = m_extensionContext.get();
+    RefPtr page = nativePage();
+    if (!context || !page || !isValid())
+        return false;
+    RefPtr controller = context->extensionController();
+    auto state = controller->nativeBrowserTabs()->tab(page->identifier());
+    return state && state->active;
+}
+
+bool WebExtensionTab::isSelected() const { return isActive(); }
+
+String WebExtensionTab::title() const
+{
+    RefPtr page = nativePage();
+    return page && isValid() ? page->pageLoadState().title() : nullString();
+}
+
+URL WebExtensionTab::url() const
+{
+    RefPtr page = nativePage();
+    return page && isValid() ? page->pageLoadState().activeURL() : URL { };
+}
+
+URL WebExtensionTab::pendingURL() const
+{
+    RefPtr page = nativePage();
+    return page && isValid() ? page->pageLoadState().provisionalURL() : URL { };
+}
+
+bool WebExtensionTab::isLoadingComplete() const
+{
+    RefPtr page = nativePage();
+    return page && isValid() && !page->pageLoadState().isLoading();
+}
+
+bool WebExtensionTab::isDiscarded() const
+{
+    // The native browser owns each open tab's page for its entire lifetime.
+    // Hiding a tab does not discard it; there is no unload-and-restore path yet.
+    return false;
+}
+
+WebExtensionTabParameters WebExtensionTab::parameters() const
+{
+    WebExtensionTabParameters result;
+    result.identifier = identifier();
+    if (!extensionHasAccess())
+        return result;
+    bool hasPermission = extensionHasPermission() || m_extensionContext->hasPermission(WebExtensionPermission::tabs(), const_cast<WebExtensionTab*>(this));
+    result.url = hasPermission ? url() : URL { };
+    result.title = hasPermission ? title() : nullString();
+    RefPtr window = this->window();
+    result.windowIdentifier = window ? window->identifier() : WebExtensionWindowConstants::NoneIdentifier;
+    result.index = index();
+    result.active = isActive();
+    result.selected = isSelected();
+    result.loading = !isLoadingComplete();
+    result.discarded = isDiscarded();
+    result.privateBrowsing = isPrivate();
+    if (RefPtr page = nativePage()) {
+        result.audible = page->isPlayingAudio();
+        result.muted = page->isAudioMuted();
+    }
+    result.pinned = false; // The native browser has no pinned-tab state yet.
+    return result;
+}
+
+WebExtensionTabParameters WebExtensionTab::changedParameters(OptionSet<ChangedProperties> properties) const
+{
+    WebExtensionTabParameters result;
+    if (!extensionHasAccess())
+        return result;
+    if (properties.isEmpty())
+        properties = changedProperties();
+    bool hasPermission = extensionHasPermission() || m_extensionContext->hasPermission(WebExtensionPermission::tabs(), const_cast<WebExtensionTab*>(this));
+    if (properties.contains(ChangedProperties::URL))
+        result.url = hasPermission ? url() : URL { };
+    if (properties.contains(ChangedProperties::Title))
+        result.title = hasPermission ? title() : nullString();
+    if (properties.contains(ChangedProperties::Loading))
+        result.loading = !isLoadingComplete();
+    if (properties.contains(ChangedProperties::Muted))
+        result.muted = isMuted();
+    return result;
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
