+namespace WTF {
+
+URL::URL(const BUrl& url)
+{
+	// The only way to fully initialize an URL is by parsing it from a string.
+	// So let's do just that.
+	URLParser parser(String::fromUTF8(url.UrlString().String()));
+	*this = parser.result();
+}
+
+URL::operator BUrl() const
+{
+    BUrl converted;
+    converted.SetProtocol(protocol().utf8().legacyCStringPointer());
+    converted.SetUserName(user());
+    converted.SetPassword(password());
+    converted.SetHost(host().utf8().legacyCStringPointer());
+    if (port())
+        converted.SetPort(*port());
+    converted.SetPath(path().utf8().legacyCStringPointer());
+    converted.SetRequest(query().utf8().legacyCStringPointer());
+    if (hasFragmentIdentifier())
+        converted.SetFragment(fragmentIdentifier().utf8().legacyCStringPointer());
+    return converted;
+}
+
