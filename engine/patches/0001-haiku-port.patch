+namespace WebCore {
+
+class CurlCacheManager {
+    friend NeverDestroyed<CurlCacheManager>;
+public:
+    WEBCORE_EXPORT static CurlCacheManager& singleton();
+
+    WEBCORE_EXPORT void setCacheDirectory(const String&);
