+WebExtensionTemporaryDirectoryHaiku::WebExtensionTemporaryDirectoryHaiku(String&& path, String&& verifiedCRXIdentifier)
+    : m_path(WTF::move(path)), m_verifiedCRXIdentifier(WTF::move(verifiedCRXIdentifier))
+{
+}
