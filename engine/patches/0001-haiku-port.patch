+
+    enum class IsKnownIcon { No, Yes };
+    std::pair<WebCore::PlatformImagePtr, IsKnownIcon> synchronousIconForPageURL(const String&, const WebCore::IntSize&);
+    String synchronousIconURLForPageURL(const String&);
