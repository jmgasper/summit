+static void updateClickCount(int button)
+{
+    if (gLastClickPositionX != gLastMousePositionX
+        || gLastClickPositionY != gLastMousePositionY
+        || gLastClickButton != button
+        || gTimeOffset - gLastClickTimeOffset >= 1)
+        gClickCount = 1;
+    else
+        gClickCount++;
+}
