+namespace WebKit {
+
+static_assert(sizeof(JSChar) == sizeof(char16_t));
+
+JSRetainPtr<JSStringRef> toJSString(const String& string)
+{
+    auto characters = StringView(string).upconvertedCharacters();
+    return JSRetainPtr(Adopt, JSStringCreateWithCharacters(reinterpret_cast<const JSChar*>(characters.get()), characters.span().size()));
+}
+
+String toString(JSStringRef string)
+{
+    if (!string)
+        return nullString();
+    if (!JSStringGetLength(string))
+        return emptyString();
+
+    return String { std::span(reinterpret_cast<const char16_t*>(JSStringGetCharactersPtr(string)), JSStringGetLength(string)) };
+}
