+bool Pasteboard::hasData()
+{
+    bool result = false;
+
+    if (be_clipboard->Lock()) {
+        BMessage* data = be_clipboard->Data();
+
+        if (data)
+            result = !data->IsEmpty();
+
+        be_clipboard->Unlock();
+    }
+
+    return result;
+}
+
+void Pasteboard::clear(const String& type)
+{
+    if (be_clipboard->Lock()) {
+        BMessage* data = be_clipboard->Data();
+
+        if (data) {
+            data->RemoveName(BString(type).String());
+            be_clipboard->Commit();
+        }
+
+        be_clipboard->Unlock();
+    }
+}
