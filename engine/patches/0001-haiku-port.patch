+// Values retain the Cocoa API's modifier ABI.
+enum class WebExtensionCommandModifier : uint32_t {
+    Shift = 1 << 17,
+    Control = 1 << 18,
+    Option = 1 << 19,
+    Command = 1 << 20
+};
