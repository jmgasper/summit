+			const BString&		URL() const;
+			bool				IsMissing() const;
+			bool				IsFinished() const;
+
+			void				DownloadFinished();
+			void				CancelDownload();
+
+	static	void				SpeedVersusEstimatedFinishTogglePulse();
+
+private:
