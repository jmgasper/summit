+			void				DecreaseZoomFactor(bool textOnly);
+			void				ResetZoomFactor();
+
+			void				FindString(const char* string,
+									bool forward = true,
+									bool caseSensitive = false,
+									bool wrapSelection = true,
+									bool startInSelection = false);
