{
  "manifest_version": 2,
  "name": "Summit Private Probe",
  "version": "1.0",
  "description": "Test extension: marks the pages it runs in and counts them in one background page, to show which windows an extension reaches.",
  "browser_specific_settings": { "gecko": { "id": "private-probe@summit.test" } },
  "permissions": ["tabs", "storage"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Private Probe", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end" }]
}
