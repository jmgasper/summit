{
  "manifest_version": 2,
  "name": "Summit tab messaging fixture",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "summit-tab-messaging"
    }
  },
  "permissions": [
    "tabs",
    "http://127.0.0.1/*"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
