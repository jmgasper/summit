{
  "manifest_version": 2,
  "name": "Summit DNR and downloads fixture",
  "version": "1.0",
  "permissions": ["declarativeNetRequest", "downloads", "<all_urls>"],
  "background": {"page": "background.html", "persistent": true},
  "browser_action": {"default_title": "DNR/downloads results", "default_popup": "results.html"},
  "declarative_net_request": {
    "rule_resources": [{"id": "static_block", "enabled": false, "path": "rules.json"}]
  }
}
