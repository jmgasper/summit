{
  "manifest_version": 2,
  "name": "Summit archive package",
  "version": "2.0",
  "permissions": ["cookies", "storage", "https://summit-cookie.invalid/*", "summitUnknownCapability"],
  "background": {"page": "background.html", "persistent": true},
  "content_scripts": [{"matches": ["https://summit-content.invalid/*"], "js": ["background.js"]}]
}
