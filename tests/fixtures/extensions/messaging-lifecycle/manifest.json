{
  "manifest_version": 2,
  "name": "Summit messaging lifecycle fixture",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "summit-messaging-lifecycle"}},
  "permissions": ["tabs", "http://127.0.0.1/*"],
  "background": {"page": "background.html", "persistent": true},
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*"],
    "js": ["config.js", "content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }]
}
