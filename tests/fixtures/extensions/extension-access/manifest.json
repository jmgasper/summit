{
  "manifest_version": 2,
  "name": "Summit extension access tests",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "__EXTENSION_ID__"}},
  "permissions": ["tabs", "http://127.0.0.1/*"],
  "background": {"page": "background.html", "persistent": true},
  "browser_action": {"default_title": "Extension access", "default_popup": "view.html?kind=popup"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end"}]
}
