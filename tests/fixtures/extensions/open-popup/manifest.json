{
  "manifest_version": 2,
  "name": "Summit programmatic popup tests",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "summit-open-popup"}},
  "permissions": ["activeTab", "http://127.0.0.1/*"],
  "background": {"page": "background.html", "persistent": true},
  "browser_action": {"default_title": "Popup loading", "default_popup": "popup.html"},
  "content_security_policy": "script-src 'self'; object-src 'none'; style-src 'self' http://127.0.0.1:*"
}
