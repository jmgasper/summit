{
  "manifest_version": 2,
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "1.0",
  "default_locale": "en",
  "browser_specific_settings": {"gecko": {"id": "summit-i18n"}},
  "permissions": ["http://127.0.0.1/*"],
  "background": {"page": "background.html", "persistent": true},
  "browser_action": {"default_title": "__MSG_action_title__", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["config.js", "suite.js", "content.js"], "css": ["localized.css"], "run_at": "document_idle"}]
}
