{
  "manifest_version": 2,
  "name": "Summit tab messaging isolation fixture",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "summit-tab-messaging-other"
    }
  },
  "permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
