{
  "manifest_version": 2,
  "name": "Summit dynamic icon tests",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "summit-action-icons"}},
  "permissions": ["tabs"],
  "background": {"page": "background/index.html", "persistent": true},
  "browser_action": {"default_title": "Icons loading", "default_icon": "icons/manifest.svg"}
}
